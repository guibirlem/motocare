# Modelo de PRODUCAO. Copiar apenas no servidor para backend/.env.
# Preencher em arquivo privado; nunca publicar o arquivo preenchido.
APP_NAME=MotoCare
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://motocare.example.com
FRONTEND_URL=https://motocare.example.com
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=motocare
DB_USERNAME=motocare
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=motocare-production-session
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
FEATURE_FINANCEIRO=true

# Ao importar dados, preservar APP_KEY e o arquivo VAPID existentes.
WEBPUSH_SUBJECT=https://motocare.example.com
WEBPUSH_KEY_PATH=/var/www/motocare/shared/private/webpush-vapid.json

# Manter envio desativado ate configurar SMTP real e testar recebimento.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=MotoCare
