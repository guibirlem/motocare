# Ubuntu24.04 / PHP8.3-FPM; adaptar dominio/socket ao servidor confirmado.
# Instalar apenas depois da emissao do certificado. Nunca servir a raiz do repo.
server {
    listen 80;
    listen [::]:80;
    server_name motocare.example.com;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }

    location / {
        return 301 https://motocare.example.com$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name motocare.example.com;
    server_tokens off;
    root /var/www/motocare/current/frontend/dist;
    index index.html;
    charset utf-8;
    client_max_body_size 2m;

    ssl_certificate /etc/letsencrypt/live/motocare.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/motocare.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    location ~ /\. {
        return 404;
    }

    location ~* ^/(backend|storage|vendor|node_modules|src|tmp|entrega|deploy|\.git)(/|$) {
        return 404;
    }

    # REQUEST_URI mantem /api/...; somente o front controller PHP e executado.
    location ~ ^/api(?:/|$) {
        rewrite ^ /index.php break;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/motocare/current/backend/public/index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/motocare/current/backend/public;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ \.php(?:/|$) {
        return 404;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location /icons/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
